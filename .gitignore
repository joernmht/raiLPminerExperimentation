
# Corpus acquisition scratch (downloaded arXiv/PDF sources).
corpusbuilder/_mathml2latex/node_modules/
corpus/_dossier_batch.log
corpus/dossiers/_src/
corpus/_elsevier_dois.txt
corpus/_other_batch.log
corpus/_other_dois.txt
corpus/review/
# Fill-in-the-blank declaration stubs — regenerable by `corpusbuilder.promote`;
# the completed `<paper_key>.tex` sidecars ARE corpus artifacts and are committed.
corpus/declarations/*.stub.tex
corpus/_snowball1_batch.log
corpus/_snowball1_dois.txt
# Crash-safe scratch for an interrupted `_discover` sweep; never a corpus artifact.
corpus/candidates.partial.json
# Covers .env, .env.save (nano emergency backups), .env.bak, etc. — but keep the example.
*.egg-info/
.env
.env.*
!.env.example
# Generated artifacts — regenerable with `python -m railpminer run`.
.ipynb_checkpoints/
.mypy_cache/
# Node bridge deps (run `npm install` in corpusbuilder/_mathml2latex)
outputs/*
!outputs/.gitkeep
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
# Secrets — real keys live here (chmod 600); never committed. See .env.example.
# Elsevier TDM full text + derived prose — never commit/publish (same rule as corpus/review/)
corpus/fulltext/
corpus/prose/

# verifier-demo run artifacts (LLM transcripts/outputs — unreviewed, never commit)
corpus/vdemo/
# LLM-assisted resolution cache + reports — prompts embed Elsevier TDM prose (never commit)
corpus/assist/
# talk figures/numbers — regenerable aggregates (corpusbuilder.talkpack); delivered via notify, not git
corpus/talkpack/
